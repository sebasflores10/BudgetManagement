@*
    (Udemy): ¿Olvidó su Contraseña? - Generando el Código Secreto
*@

@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Olvidé mi contraseña";
}

<h1>Recupera tu cuenta</h1>
<div class="card">
    <div class="card-body">
        <p class="fw-bold">@ViewBag.Message</p>

        <form asp-action="ForgotPassword" id="formForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="email" class="form-label"></label>
                <input asp-for="email" class="form-control" />
                <span asp-validation-for="email"></span>
            </div>

            <div class="text-center">
                <button class="btn btn-success mx-3">Recuperar</button>
                <a asp-action="UserLogin" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover">Cancelar</a>
            </div>
        </form>
    </div>
</div>
