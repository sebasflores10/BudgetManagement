@*
    (Udemy): 194. ¿Olvidó su Contraseña? - Permitiendo el Cambio de Contraseña
*@

@model PasswordResetViewModel

@{
    ViewData["Title"] = "Reinicio de contraseña";
}

<h1>Reinicio de contraseña</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="ResetPassword" id="formResetPassword">
            <div asp-validation-summary="ModelOnly" class="text-dager"></div>
            <input type="hidden" asp-for="token" />

            <div class="mb-3">
                <label asp-for="email" class="form-label"></label>
                <input asp-for="email" class="form-control" />
                <span asp-validation-for="email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="password" class="form-label"></label>
                <input asp-for="password" class="form-control" />
                <span asp-validation-for="password" class="text-danger"></span>
            </div>

            <button class="btn btn-success" style="margin-right: 10px">Reiniciar</button>
            <a asp-action="UserLogin" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover">
                Cancelar
            </a>
        </form>
    </div>
</div>
