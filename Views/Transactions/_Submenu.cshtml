@model TransactionsSubmenu

<ul class="nav nav-pills nav-fill mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model == TransactionsSubmenu.Diario ? "active" : null)" 
        asp-action="Index">Diario</a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(Model == TransactionsSubmenu.Semanal ? "active" : null)" 
        asp-action="Weekly">Semanal</a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(Model == TransactionsSubmenu.Mensual ? "active" : null)" 
        asp-action="Monthly">Mensual</a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(Model == TransactionsSubmenu.Excel ? "active" : null)" 
        asp-action="ExcelReport">Excel</a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(Model == TransactionsSubmenu.Calendario ? "active" : null)" 
        asp-action="Calendar">Calendario</a>
    </li>
</ul>
