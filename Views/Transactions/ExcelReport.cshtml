@*
    (Udemy): 155. Creando un Submenú
    (Udemy): 161. Exportar Excel - Por Mes
*@

@{
    ViewData["Title"] = " Reporte Excel";
    var today = DateTime.Today;
    var aboutAMonthAgo = today.AddMonths(-1);
    var actualMonth = today.Month;
    var actualYear = today.Year;
    var previousMonth = aboutAMonthAgo.Month;
    var previousYear = aboutAMonthAgo.Year;

    @* (Udemy): 162. Exportar a Excel - Por Año *@
    var prevYear = actualYear - 1;
}

<partial name="_Submenu" Model="TransactionsSubmenu.Excel" />

<h1>Exportar a Excel</h1>

<div class="mb-3">
    <a asp-action="ExportingExcelByMonth" asp-route-month="@actualMonth" 
    asp-route-year="@actualYear" class="btn btn-success">
        Exportar mes actual
    </a>
    ~ @today.ToString("MMMM yyyy")
</div>

<div class="mb-3">
    <a asp-action="ExportingExcelByMonth" asp-route-month="@previousMonth"
       asp-route-year="@previousYear" class="btn btn-success">
        Exportar mes anterior
    </a>
    ~ @aboutAMonthAgo.ToString("MMMM yyyy")
</div>

<div class="mb-3">
    <a asp-action="ExportExcelByYear" asp-route-year="@actualYear" class="btn btn-success">
        Exportar año actual
    </a>
    ~ @actualYear
</div>

<div class="mb-3">
    <a asp-action="ExportExcelByYear" asp-route-year="@prevYear" class="btn btn-success">
        Exportar año anterior
    </a>
    ~ @prevYear
</div>

<div class="mb-3">
    <a asp-action="ExportAllExcel" class="btn btn-success">
        Exportar todo
    </a>
</div>
