@*
    1. (Udemy): 153. Vista del Reporte Diario
    2. (Udemy): 158. Reporte Semanal - Vista [5:20 mins] [9:15 mins - _MonthNav]
    *************************************************************************************
    Creando la vista parcial para que el reporte que se realizó anteriormente en
    "Views/BudgetAccount/BudgetAccountDasboard.cshtml", pueda ser reutilizado tanto en 
    "BudgetAccount/" como en "Transactions/".
*@

@model TransactionsDashboard

@{
    @* (Udemy): 158. Reporte Semanal - Vista [6:05 mins] *@
    var amountSummary = new AmountSummaryViewModel()
    {
        Ingreso = Model.deposits_balance,
        Egreso = Model.withdrawals_balance,
        Total = Model.total
    };
}

@* Control de los meses fue movido a "Shared/_MonthNav.cshtml" *@
<partial name="_MonthNav" model="@Model.start_date" />

@* Resumen del monto fue modificado a "Shared/_AmountSummary.cshtml" *@
<partial name="_AmountSummary" model="@amountSummary" />

@if (Model.transactions_by_date.Count() == 0)
{
    <h5 class="align-content-center">No hay transacciones en este mes</h5>
}
else
{
    <table class="table table-group-divider table table-secondary table-responsive">
        <tbody>
            @* Para las transacciones por dia *@
            @foreach (var transactions_by_date in Model.transactions_by_date)
            {
                <tr>
                    <td colspan="3">
                        @transactions_by_date.transaction_date.Day
                        <span class="badge bg-secondary">
                            @transactions_by_date.transaction_date.ToString("dddd")
                        </span>
                    </td>

                    <td class="activos-accordion">
                        @transactions_by_date.deposits.ToString("N")
                    </td>

                    <td class="pasivos-accordion">
                        @transactions_by_date.withdrawals.ToString("N")
                    </td>
                </tr>

                @* Para toda transacción realizada dentro del día *@
                @foreach (var transaction in transactions_by_date.user_transactions_list)
                {
                    <tr style="vertical-align: middle">
                        <td>
                            <a asp-controller="Transactions" asp-action="UpdateTransaction"
                               asp-route-returnURL="@ViewBag.returnURL"
                               asp-route-transaction_id="@transaction.transaction_id">
                                <i class="bi-pencil"></i>
                            </a>
                        </td>

                        <td>
                            @transaction.Categoria
                        </td>

                        <td>
                            @transaction.Cuenta
                        </td>

                        <td class="activos-accordion">
                            @(transaction.operation_type_id == OperationType.Ingreso ?
                            transaction.amount.ToString("N") : null)
                        </td>

                        <td class="pasivos-accordion">
                            @* Need improvements to show better colors *@
                            @(transaction.operation_type_id == OperationType.Egreso ?
                            transaction.amount.ToString("N") : null)
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}