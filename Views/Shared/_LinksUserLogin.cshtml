@*
    (Udemy): 175. Asignando una Cookie al Registrar al Usuario
*@

@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> signInManager


<ul class="navbar-nav">
    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">@User.Identity.Name</span>
        </li>

        <li class="nav-item">
            <form class="form-check-inline" asp-action="UserLogout" asp-controller="Users">
                <button type="submit" class="nav-link btn btn-link text-dark">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link dark-text" asp-controller="Users" asp-action="RegisterUser">
                Registrarse
            </a>
        </li>
        
        <li class="nav-item">
            <a class="nav-link dark-text" asp-controller="Users" asp-action="UserLogin">
                Login
            </a>
        </li>
    }
</ul>
