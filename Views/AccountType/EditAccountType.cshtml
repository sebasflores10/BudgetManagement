@*
    (Udemy): Actualizando Tipos Cuentas
    Formulario reutilizado de "Views/AccountType/EditAccountType.cshtml"
*@

@model AccountType

@{
    ViewData["Title"] = "Editar Tipos Cuentas";
}

<h1>Editar tipo de cuenta: @Model.account_type_name</h1>
<h5 class="mb-3">
    El tipo de cuenta se refiere a cómo podemos agrupar cuentas. <br />
    Ejemplo: Préstamos, tarjetas de crédito, cuentas de ahorro, etc.
</h5>

@*
    (Udemy): 102. Visualizando los Errores de Validación
    Requiere del uso de DataAnnotations en el modelo. (Models/AccountType.cs)
*@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-controller="AccountType" asp-action="EditAccountType">
    @* 
        Capturamos el ID del tipo de cuenta con el siguiente input...
        (Udemy): 117. Actualizando Tipos Cuentas [6:30 mins]
    *@
    <input type="hidden" asp-for="account_type_id" />

    <div class="mb-3">
        <label asp-for="account_type_name" class="form-label"></label>
        <input type="text" id="accountTypeName" asp-for="account_type_name" class="form-control" />
        <span asp-validation-for="account_type_name" class="text-danger mt-sm-3"></span>
    </div>

    <button type="submit" class="btn btn-primary">Editar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>


@* (Udemy): Validación en el Front-End [3:00 mins] *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}